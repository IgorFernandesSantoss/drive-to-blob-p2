# Pasta publica: chave de API. Pasta privada: Service Account.
GOOGLE_API_KEY=<chave de API do Google com a Drive API ativa>
# GOOGLE_SERVICE_ACCOUNT_JSON=<conteudo do JSON da chave da Service Account, ou o base64 dele>
GOOGLE_DRIVE_FOLDER_ID=<id da pasta na URL do Drive>
# Use a BlobSASURL OU a Connection String (ambas estao no Word da prova)
AZURE_BLOB_SAS_URL=https://<conta>.blob.core.windows.net/?sv=...&sig=...
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<conta>;AccountKey=<chave>;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER_NAME=aluno-igorfernandes
